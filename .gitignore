# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---------- Environments ----------
.venv/
.env
.env.*

# ---------- Tooling caches ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- Project data & outputs ----------
# Datasets are downloaded by `rtm download`; never commit them.
data/*
!data/.gitkeep

# Run reports are regenerated by `rtm evaluate`. Commit selected
# reports deliberately (e.g. results/) rather than the whole folder.
runs/*
!runs/.gitkeep

# Model / embedding caches
.cache/
*.npy
*.faiss

# ---------- OS / editors ----------
.DS_Store
.idea/
.vscode/
